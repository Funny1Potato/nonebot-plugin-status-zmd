# ===== 终末状态图（nonebot-plugin-status-zmd）配置示例 =====
# 只列出本插件的配置项，改完重启生效。

# ---- 行为 ----
# 触发指令：第一个为主指令，其余为别名
ZMD_COMMAND=["status", "系统状态"]
# 仅 SUPERUSER 可用（状态图含主机名/IP/进程/磁盘，不建议公开）
ZMD_ONLY_SUPERUSER=true
# 需要 @ 机器人才能触发
ZMD_NEED_AT=false
# 回复触发者消息
ZMD_REPLY_TARGET=true

# ---- 版式 ----
# full=综合长图 | gauge=只出电量环 | perf=只出设备性能
ZMD_LAYOUT=full
# 板块开关，可选：header gauge apps bots perf specs footer
ZMD_BLOCKS=["header", "gauge", "apps", "bots", "perf", "specs", "footer"]
# 顶栏显示的主机名，留空则用系统主机名
# ZMD_HOST_NAME=ENDFIELD-01

# ---- 电量环 ----
# 环中间大数字的分母（终末地游戏口径）
ZMD_GAUGE_VALUE_MAX=325799
# 综合占用权重：CPU × 0.4 + 内存 × 0.6
ZMD_GAUGE_CPU_WEIGHT=0.4
ZMD_GAUGE_MEM_WEIGHT=0.6

# ---- 渲染 ----
ZMD_PIC_FORMAT=jpeg
ZMD_PIC_QUALITY=90
# 出图缩放倍率，2 表示按 2 倍分辨率渲染（图更清晰、体积更大）
ZMD_DEVICE_SCALE_FACTOR=2
# 单张图渲染超时（秒）
ZMD_RENDER_TIMEOUT=30
# CSS 字体栈覆盖，例如 "Noto Sans CJK SC" / "Source Han Sans SC"
# ZMD_FONT_FAMILY="Noto Sans CJK SC"
# 指定字体文件并内联进图片（≤ 8MB），最稳的字形一致方案
# ZMD_FONT_PATH=/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc
# 追加自定义 CSS 文件
# ZMD_EXTRA_CSS=/path/to/custom.css

# ---- 采样 ----
# 后台常驻采样间隔（秒）
ZMD_COLLECT_INTERVAL=5
# 走势图保留的采样点数（窗口 = 间隔 × 点数，默认约 15 分钟）
ZMD_HISTORY_SIZE=180
# 进程列表长度与排序依据
ZMD_PROC_LEN=8
ZMD_PROC_SORT_BY=cpu
# 忽略的分区/网卡/进程（正则，JSON 数组）
ZMD_IGNORE_PARTS=[]
ZMD_IGNORE_NETS=["^lo(op)?\\d*$|^(Loopback|本地连接)"]
ZMD_IGNORE_PROCS=["^System Idle Process$"]
# 进程 CPU 是否按单核算（false=折算成整机占比，与任务管理器口径一致）
ZMD_PROC_CPU_MAX_100P=false

# ---- Bot 状态 ----
# 统计发送消息数（按各适配器的发消息 API 名计数）
ZMD_COUNT_MESSAGE_SENT=true
# 拉取 Bot 头像
ZMD_SHOW_BOT_AVATAR=true
# Bot 断开时清零收发计数
ZMD_DISCONNECT_RESET_COUNTER=true
# 拉取头像/Bot 信息的超时（秒）
ZMD_REQ_TIMEOUT=10

# ---- 全局 ----
# 出图时拉取头像用的代理
# PROXY=http://127.0.0.1:7890

# ===== 渲染后端（nonebot-plugin-htmlrender >= 0.8 需要） =====
# 0.6 / 0.7 无需配置；0.8+ 必须选 Provider，否则出图会提示不可用
# RENDER={"provider": "playwright", "startup": "warmup"}