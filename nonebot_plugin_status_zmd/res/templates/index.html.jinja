{% from 'macros.html.jinja' import topbar, gauge, apps, bots, perf, specs, bottom %}
<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <title>终末状态 · ENDFIELD STYLE</title>
  <style>{{ css|safe }}</style>
  {% if font_css %}<style>{{ font_css|safe }}</style>{% endif %}
  {% if extra_css %}<style>{{ extra_css|safe }}</style>{% endif %}
</head>
<body>
  <main class="page">
    {{ topbar(m) }}
    {% set show_columns = m.gauge and (m.apps or m.bots) %}
    {% if show_columns %}
    <div class="overview-grid">
      {{ gauge(m) }}
      <div class="right-col">
        {% if m.apps %}{{ apps(m) }}{% endif %}
        {% if m.bots %}{{ bots(m) }}{% endif %}
      </div>
    </div>
    {% else %}
      {% if m.gauge %}<div class="gauge-solo">{{ gauge(m) }}</div>{% endif %}
      {% if m.apps %}{{ apps(m) }}{% endif %}
      {% if m.bots %}{{ bots(m) }}{% endif %}
    {% endif %}
    {% if m.perf %}{{ perf(m) }}{% endif %}
    {% if m.specs %}{{ specs(m) }}{% endif %}
    {{ bottom(m) }}
  </main>
  <script>
    (() => {
      const done = () => document.body.classList.add('done');
      if (document.fonts && document.fonts.ready) {
        document.fonts.ready.then(done, done);
      } else {
        done();
      }
    })();
  </script>
</body>
</html>
