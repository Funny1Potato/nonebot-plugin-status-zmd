{# 状态卡片的可复用视图；数值与视觉装饰分开组织。 #}

{% macro ic(key, size=16) -%}
<span class="ic">{{ icon(key, size) }}</span>
{%- endmacro %}

{% macro topbar(m) %}
<header class="masthead">
  <div class="identity">
    <span class="identity-mark">END</span>
    <span class="identity-name"><i>//</i>STATUS</span>
  </div>
  <nav class="section-nav">
    {% for label, symbol, selected in [('综合', 'globals', m.gauge), ('设备', 'cpu', m.perf), ('终端', 'link', m.bots)] %}
    <div class="section-link{{ ' selected' if selected }}">
      <span class="section-symbol">{{ icon(symbol, 16) }}</span>{{ label }}
    </div>
    {% endfor %}
  </nav>
  <div class="masthead-fill"></div>
  <div class="source-pill">
    <span class="source-indicator {{ 'live' if m.source_ok else 'warn' }}"></span>{{ m.source_text }}
  </div>
  <div class="host-chip">{{ m.host_name }}</div>
</header>
{% endmacro %}

{% macro gauge(m) %}
<section class="gauge-wrap">
  <div class="dial-art">{{ m.gauge.svg|safe }}</div>
  <div class="dial-readout">
    <div class="report-chip"><span>占用报告</span> <span class="switch-mark"></span></div>
    <div class="readout-number">{{ '{:,}'.format(m.gauge.value) }}</div>
    <div class="readout-limit">/ {{ '{:,}'.format(m.gauge.value_max) }}</div>
    <div class="readout-time">{{ m.gauge.uptime }}</div>
    <div class="readout-caption">已运行</div>
  </div>
  <div class="metric-flag actual-flag">
    <span class="metric-label">实际占用</span>
    <span class="metric-value">{{ '{:,}'.format(m.gauge.value) }}</span>
  </div>
  <div class="metric-flag peak-flag">
    <span class="metric-value">{{ '{:,}'.format(m.gauge.value_peak) }}</span>
    <span class="metric-label">最大占用</span>
  </div>
</section>
{% endmacro %}

{% macro panel_heading(title, meta) %}
<div class="panel-title">
  <h2>{{ title }}</h2>
  <div class="meta">{{ meta }}</div>
</div>
{% endmacro %}

{% macro apps(m) %}
<section class="process-panel">
  {{ panel_heading('应用概况', (m.apps|length)|string ~ ' 项 · 按' ~ ('内存' if m.proc_sort_by == 'mem' else 'CPU') ~ '排序') }}
  <div class="col-head process-columns">
    <div class="h">{{ ic('server') }}进程</div>
    <div class="h end">CPU</div>
    <div class="h end">内存</div>
  </div>
  {% for r in m.apps %}
  <div class="process-entry">
    <div class="name">
      <div class="icon">{{ r.icon|safe }}</div>
      <div>
        <div class="nm">{{ r.name }}</div>
        <div class="sub">{{ r.sub }}</div>
      </div>
    </div>
    <div class="cell">
      <span class="v">{{ '%.1f'|format(r.cpu) }}</span><span class="u">%</span>
      <div class="spark-track"><div class="spark-fill" style="width: {{ '%.1f'|format(r.cpu_pct) }}%"></div></div>
    </div>
    <div class="cell">
      <span class="v">{{ (r.mem // 1048576) }}</span> <span class="u dim">MB</span>
      <div class="spark-track"><div class="spark-fill" style="width: {{ '%.1f'|format(r.mem_pct) }}%"></div></div>
    </div>
  </div>
  {% endfor %}
</section>
{% endmacro %}

{% macro bots(m) %}
<section class="bots-panel">
  {{ panel_heading('终端链路', (m.bots|length)|string ~ ' 个 Bot') }}
  <div class="col-head bot-columns">
    <div class="h">{{ ic('bot') }}终端</div>
    <div class="h end">连接时长</div>
    <div class="h end">接收</div>
    <div class="h end">发送</div>
  </div>
  {% for r in m.bots %}
  <div class="bot-row">
    <div class="name">
      {% if r.avatar %}
      <img class="avatar" src="{{ r.avatar }}" alt="">
      {% else %}
      <div class="avatar">{{ r.icon|safe }}</div>
      {% endif %}
      <div>
        <div class="nm">{{ r.nickname or r.self_id }}</div>
        <div class="sub">
          <span class="link-state"><span class="dot{{ ' live' if r.online }}"></span>{{ '在线' if r.online else '离线' }}</span>
          · {{ r.self_id }}{% if r.adapter != '—' %} · {{ r.adapter }}{% endif %}
        </div>
      </div>
    </div>
    <div class="cell"><span class="v">{{ r.uptime }}</span></div>
    <div class="cell"><span class="v">{{ r.recv }}</span></div>
    <div class="cell"><span class="v">{{ r.send }}</span></div>
  </div>
  {% endfor %}
</section>
{% endmacro %}

{% macro perf(m) %}
<section class="perf-panel">
  {{ panel_heading('设备性能', m.sample_desc) }}
  <div class="perf-head-strip">
    <div class="h">{{ ic('server') }}设备信息</div>
    <div class="h center">{{ ic('timer') }}占用率走势</div>
    <div class="h pad">{{ ic('globals') }}当前数据</div>
    <div class="h">{{ ic('link') }}规格</div>
  </div>
  {% for r in m.perf %}
  <div class="perf-row">
    <div class="dev-info">
      <div class="dev-txt">
        <div class="nm">{{ r.name }}</div>
        <div class="sub">{{ r.sub }}</div>
      </div>
      <div class="dev-icon">{{ r.icon|safe }}</div>
    </div>
    <div class="chart-cell">{{ spark(r, m.slots, loop.index0)|safe }}</div>
    <div class="cur-cell">
      <div class="cur-line">
        <span class="series-dot primary"></span>
        <span class="lbl">{{ r.cur1_label }}</span>
        <span class="v">{{ r.cur1_value }}</span>
      </div>
      <div class="cur-line">
        <span class="series-dot secondary"></span>
        <span class="lbl">{{ r.cur2_label }}</span>
        <span class="v">{{ r.cur2_value }}</span>
      </div>
    </div>
    <div class="spec-line">
      <span class="lbl">{{ r.spec_label }}</span>
      <span class="v">{{ r.spec_value }}</span>
    </div>
  </div>
  {% endfor %}
</section>
{% endmacro %}

{% macro specs(m) %}
<section class="specs-panel">
  {{ panel_heading('设备信息', m.system) }}
  <div class="specs-grid">
    {% for label, value in m.specs %}
    <div class="spec-item">
      <span class="lbl">{{ label }}</span>
      <span class="v">{{ value }}</span>
    </div>
    {% endfor %}
  </div>
</section>
{% endmacro %}

{% macro bottom(m) %}
<footer class="bottom-bar">
  {% for tag in m.tags %}
  <div class="tag">{{ tag }}</div>
  {% endfor %}
  <div class="tag dark">{{ m.backend }}</div>
  <div class="stamp">
    <span class="icon-tile">{{ icon('clock', 96) }}</span>
    <span class="lbl">{{ m.generated_at }}</span>
  </div>
</footer>
{% endmacro %}